{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "openid-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "event-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/v1/events/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },
      "locations-route": {
        "ClusterId": "gps-cluster",
        "Match": {
          "Path": "/api/v1/locations/{**catch-all}"
        }
      },
      "gps-route": {
        "ClusterId": "gps-cluster",
        "Match": {
          "Path": "/api/v1/gps/{**catch-all}"
        }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/v1/search/{**catch-all}"
        }
      },
      "blockchain-route": {
        "ClusterId": "blockchain-cluster",
        "Match": {
          "Path": "/api/v1/blockchain/{**catch-all}"
        }
      },
      "chatbot-route": {
        "ClusterId": "chatbot-cluster",
        "Match": {
          "Path": "/api/v1/chatbot/{**catch-all}"
        }
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/v1/analytics/{**catch-all}"
        }
      },
      "admin-analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/v1/media/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://127.0.0.1:5001"
          }
        }
      },
      "event-cluster": {
        "Destinations": {
          "event-service": {
            "Address": "http://127.0.0.1:5004"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-service": {
            "Address": "http://127.0.0.1:5010"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://127.0.0.1:5011"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://127.0.0.1:5012"
          }
        }
      },
      "gps-cluster": {
        "Destinations": {
          "gps-service": {
            "Address": "http://127.0.0.1:3001"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-service": {
            "Address": "http://127.0.0.1:3003"
          }
        }
      },
      "blockchain-cluster": {
        "Destinations": {
          "blockchain-service": {
            "Address": "http://127.0.0.1:3004"
          }
        }
      },
      "chatbot-cluster": {
        "Destinations": {
          "chatbot-service": {
            "Address": "http://127.0.0.1:3005"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics-service": {
            "Address": "http://127.0.0.1:5015"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-service": {
            "Address": "http://127.0.0.1:3002"
          }
        }
      }
    }
  }
}
