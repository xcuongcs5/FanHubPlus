# Generate .env with Initialize-Environment.ps1; do not commit actual passwords.
# Bootstrap accepts 20-128 characters: A-Z a-z 0-9 _ @ # ! % + = . -
MSSQL_SA_PASSWORD=REPLACE_WITH_GENERATED_SECRET
EVENT_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
BOOKING_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
PAYMENT_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
RABBITMQ_PASSWORD=REPLACE_WITH_GENERATED_SECRET
REDIS_PASSWORD=REPLACE_WITH_GENERATED_SECRET
SQL_PORT=14334
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
REDIS_PORT=6381
BOOKING_HTTP_PORT=5010
# Public address supplied by Blockchain team; no private key belongs in Booking.
BLOCKCHAIN_SIGNER_ADDRESS=

NOTIFICATION_HTTP_PORT=5012
# Local only; Start-NotificationService.ps1 -WithFirebase enables secret mount.
FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_FILE=../secrets/firebase-service-account.json
